# Django Secret Key (change this to something secret in production)
SECRET_KEY=django-insecure-your-secret-key-here

# Enable debugging (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Database connection URL
# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
DB_URL=postgres://postgres:root@localhost:5432/club_management
# SQLite: sqlite:///db.sqlite3

# Email Configurations
# Console backend prints emails to the terminal (recommended for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP backend configuration (uncomment and configure if real emails are needed)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=ClubSphere <your_email@gmail.com>

# Twilio Configurations for WhatsApp Bot
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Leaderboard points awarded per event approval
EVENT_APPROVAL_POINTS=10
