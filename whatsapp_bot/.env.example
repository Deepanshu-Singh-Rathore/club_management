# ── Whapi.Cloud credentials ───────────────────────────────────────────────────
# 1. Sign up at https://whapi.cloud
# 2. Create a channel → scan QR with your WhatsApp
# 3. Copy the token from: Dashboard → Your Channel → Settings → Token

WHAPI_TOKEN=your_channel_token_here

# Whapi.Cloud API base URL (no need to change this)
WHAPI_API_URL=https://gate.whapi.cloud

# ── Bot HTTP API ──────────────────────────────────────────────────────────────
# Port this service listens on (Django calls this)
BOT_API_PORT=3001

# Secret token Django must send as Bearer token
BOT_SECRET_TOKEN=your-secret-token-here
