# Django backend base URL (no trailing slash)
DJANGO_API_URL=http://127.0.0.1:8000/api

# JWT token for the bot service account (create a dedicated bot user in Django admin
# with role=admin and generate a token via /api/auth/login/)
BOT_API_TOKEN=your_bot_jwt_token_here

# Twilio credentials (from https://console.twilio.com)
ACCOUNT_SID=
AUTH_TOKEN=

# Your Twilio WhatsApp number (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Port for the Express webhook server
PORT=3000
