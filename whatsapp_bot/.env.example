# Django backend base URL (no trailing slash)
DJANGO_API_URL=http://127.0.0.1:8000/api

# JWT token for the bot service account (create a dedicated bot user in Django admin
# with role=admin and generate a token via /api/auth/login/)
BOT_API_TOKEN=your_bot_jwt_token_here

# Twilio credentials (from https://console.twilio.com)
ACCOUNT_SID=
AUTH_TOKEN=

# Your Twilio WhatsApp number (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Port for the Express webhook server
PORT=3000

SECRET_KEY=django-insecure-change-this-to-something-secret-in-production

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# PostgreSQL
DB_NAME=club_management
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432

# Email – console backend for development (prints OTPs to terminal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=testerdeveloper05@gmail.com
EMAIL_HOST_PASSWORD=zyvtclazsoiauloe
DEFAULT_FROM_EMAIL=ClubSphere <testerdeveloper05@gmail.com>